# ═══════════════════════════════════════════════════════════════════════════
#  Sip & Scoop — environment variables
#  Copy this file to ".env" (local) and add the same values in Vercel →
#  Project → Settings → Environment Variables. NEVER commit the real .env file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) — REQUIRED ─────────────────────────────────
# Supabase → your project → "Connect" button (top of the dashboard) → ORMs tab / Connection string.
# DATABASE_URL = "Transaction pooler" string (port 6543) — used by the website (works on Vercel).
# DIRECT_URL   = "Session pooler" string (port 5432) — used by migrations & seed.
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: connections per server instance (default 5)
# DB_POOL_MAX=5

# ── Admin login — REQUIRED ────────────────────────────────────────────────────
# Used ONCE by `npm run db:seed` to create the first owner account. Change the password
# in Admin → Team after your first login (the seed never overwrites an existing account).
ADMIN_EMAIL=owner@sipandscoop.pk
ADMIN_PASSWORD=ChangeMe123!

# Signs the admin login cookie. REQUIRED in production, at least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-random-hex-characters

# Your public website address (used in emails and unsubscribe links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI assistant "Sippy" — Google Gemini (RECOMMENDED) ───────────────────────
# Get a key: https://aistudio.google.com/apikey  → "Create API key". Usage is billed per request
# once you leave the free tier — set a budget alert in Google Cloud Billing.
# Without a key the free built-in assistant answers (menu, prices, hours, delivery).
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# Model (change any time, no code edits). Google's current stable Flash model:
AI_MODEL=gemini-3.8-flash
# Switch provider later by changing AI_PROVIDER to "anthropic" or "openai" and setting:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# AI limits (optional — defaults shown)
# AI_RATE_LIMIT_PER_10MIN=20      # messages per visitor per 10 minutes
# AI_RATE_LIMIT_PER_DAY=150       # messages per visitor per day
# AI_DAILY_MESSAGE_LIMIT=3000     # all visitors together per 24 h — beyond this the free built-in assistant answers
# CHAT_RETENTION_DAYS=30          # AI chats older than this are deleted by the daily clean-up
# Optional: show estimated cost in Admin → AI chats (USD per 1 million tokens, from your provider's pricing page)
# AI_COST_INPUT_PER_MILLION=
# AI_COST_OUTPUT_PER_MILLION=

# ── Email alerts — Resend (RECOMMENDED) ──────────────────────────────────────
# https://resend.com → API Keys. Verify your domain under "Domains" so EMAIL_FROM can use it.
# Sends the owner an email for every new order, contact message and AI booking/catering request.
RESEND_API_KEY=
EMAIL_FROM=Sip & Scoop <orders@sipandscoop.pk>
ALERT_EMAILS=owner@sipandscoop.pk

# ── Product photo uploads — Supabase Storage (REQUIRED on Vercel) ─────────────
# Supabase → Project Settings → API Keys: Project URL + "service_role" secret key (server only — never expose it).
# Create a PUBLIC bucket named "product-images" in Supabase → Storage.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images
# Extra image hosts allowed for pasted image URLs (comma-separated, optional), e.g. res.cloudinary.com
# NEXT_PUBLIC_IMAGE_HOSTS=

# ── Daily clean-up job (Vercel Cron) — REQUIRED on Vercel ─────────────────────
# Any random string of 16+ characters. Vercel sends it automatically to /api/cron/cleanup.
CRON_SECRET=replace-with-a-random-string
